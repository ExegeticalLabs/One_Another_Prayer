{
  "entities": {
    "Church": {
      "title": "Church",
      "description": "A church community.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "inviteCode": { "type": "string" },
        "inviteCodeEnabled": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "inviteCode", "inviteCodeEnabled", "createdAt"]
    },
    "Membership": {
      "title": "Membership",
      "description": "User's association with a church.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "churchId": { "type": "string" },
        "role": { "type": "string", "enum": ["member", "elder", "admin"] },
        "status": { "type": "string", "enum": ["pending", "active", "denied", "suspended"] },
        "joinedAt": { "type": "number" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "number" }
      },
      "required": ["userId", "churchId", "role", "status", "joinedAt", "email", "displayName"]
    },
    "Prayer": {
      "title": "Prayer",
      "description": "A prayer request submitted for the church.",
      "type": "object",
      "properties": {
        "churchId": { "type": "string", "description": "The church this prayer belongs to." },
        "author": { "type": "string", "description": "Display name of the author or 'A Church Member'." },
        "authorId": { "type": "string", "description": "UID of the author." },
        "category": { "type": "string", "description": "Category of the prayer." },
        "text": { "type": "string", "description": "The prayer content." },
        "createdAt": { "type": "number", "description": "Server timestamp of creation." },
        "anon": { "type": "boolean", "description": "Whether it is anonymous." },
        "answered": { "type": "boolean", "description": "Whether the prayer has been answered." },
        "answerNote": { "type": "string", "description": "Optional note when answered." },
        "urgency": { "type": "string", "enum": ["URGENT", "ELEVATED", "STANDARD"], "description": "AI triage level." },
        "triageReason": { "type": "string", "description": "AI reason for urgency level." },
        "status": { "type": "string", "enum": ["approved", "hidden"], "description": "Moderation status." }
      },
      "required": ["churchId", "author", "authorId", "category", "text", "createdAt", "anon", "answered"]
    },
    "PrayerStats": {
      "title": "PrayerStats",
      "description": "Engagement metrics readable only by elders or author.",
      "type": "object",
      "properties": {
        "prayCount": { "type": "number" },
        "prayTime": { "type": "number" }
      },
      "required": ["prayCount", "prayTime"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Elder pastoral direct message.",
      "type": "object",
      "properties": {
        "churchId": { "type": "string" },
        "fromId": { "type": "string" },
        "fromName": { "type": "string" },
        "toId": { "type": "string" },
        "prayerId": { "type": "string", "description": "Context about which prayer." },
        "text": { "type": "string" },
        "createdAt": { "type": "number" },
        "read": { "type": "boolean" }
      },
      "required": ["churchId", "fromId", "fromName", "toId", "text", "createdAt", "read"]
    },
    "PrayerLog": {
      "title": "PrayerLog",
      "description": "Tracks time spent praying.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "prayerId": { "type": "string" },
        "type": { "type": "string", "enum": ["church", "personal"] },
        "durationSec": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "prayerId", "type", "durationSec", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile with role-based access.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["member", "admin"] },
        "createdAt": { "type": "number" }
      },
      "required": ["email", "displayName", "role", "createdAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "A user's bookmark to a specific prayer.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "prayerId": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "prayerId", "createdAt"]
    }
  },
  "firestore": {
    "/churches/{churchId}": {
      "schema": { "$ref": "#/entities/Church" },
      "description": "Church communities."
    },
    "/memberships/{membershipId}": {
      "schema": { "$ref": "#/entities/Membership" },
      "description": "User memberships connecting users to churches."
    },
    "/churches/{churchId}/prayers/{prayerId}": {
      "schema": { "$ref": "#/entities/Prayer" },
      "description": "Global prayer requests shared with everyone in the church."
    },
    "/churches/{churchId}/prayers/{prayerId}/internal/stats": {
      "schema": { "$ref": "#/entities/PrayerStats" },
      "description": "Private statistics accessible only to author and elders."
    },
    "/churches/{churchId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/DirectMessage" },
      "description": "Direct pastoral messages between elders and members."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile with role details."
    },
    "/users/{userId}/logs/{logId}": {
      "schema": { "$ref": "#/entities/PrayerLog" },
      "description": "Private prayer connection logs."
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/Bookmark" },
      "description": "Private bookmarks."
    }
  }
}
